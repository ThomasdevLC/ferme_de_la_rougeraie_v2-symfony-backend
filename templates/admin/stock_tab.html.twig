{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
    <div class="pt-5">
        <h1 class="title fw-bold fs-3 mb-3">📦 Stock</h1>

        <div class="table-responsive">
            <table class="table table-striped table-hover w-auto">
                <thead class="thead-dark">
                <tr>
                    <th style="padding-right: 6rem">Produit</th>
                    <th>Stock</th>
                </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    <tr>
                        {% set crud = row.isBasket ? 'App\\Controller\\Admin\\BasketCrudController' : 'App\\Controller\\Admin\\ProductCrudController' %}
                        <td style="padding-right: 6rem">
                            <a href="{{ ea_url().unsetAll().setController(crud).setAction('edit').setEntityId(row.productId) }}">{{ row.name }}</a>
                        </td>
                        <td class="{{ row.stock <= 0 ? 'text-danger fw-bold' }}">{{ row.stock|replace({'.': ','}) }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="2">Aucun produit avec un stock suivi.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
