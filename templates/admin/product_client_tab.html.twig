{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
    {% set pickupDays = {
        2: 'Mardi',
        5: 'Vendredi'
    } %}

    <style>
        .orders-print-report {
            display: none;
        }

        .orders-screen-table {
            max-width: 100%;
            overflow-x: hidden;
        }

        .orders-screen-table .orders-screen-header {
            width: 100%;
        }

        .orders-screen-table th:first-child,
        .orders-screen-table td:first-child {
            min-width: 150px;
        }

        .orders-screen-table th:not(:first-child),
        .orders-screen-table td:not(:first-child) {
            min-width: 120px;
        }

        /* Colonne « Produit » figée à gauche pendant le défilement horizontal */
        .orders-screen-table th:first-child,
        .orders-screen-table td:first-child {
            position: sticky;
            left: 0;
            z-index: 2;
            background-color: var(--bs-body-bg, #fff);
            box-shadow: 1px 0 0 rgba(0, 0, 0, .08);
        }

        .orders-screen-table thead th:first-child {
            z-index: 3;
        }

        .orders-phone {
            color: var(--bs-secondary-color, #6c757d);
            font-size: .8rem;
            font-weight: normal;
        }

        /* Noms alignés en haut, numéro sur une seule ligne */
        .orders-screen-table thead th {
            vertical-align: top;
        }

        .orders-screen-table .orders-phone {
            white-space: nowrap;
        }

        .orders-top-scroll {
            overflow-x: auto;
            overflow-y: hidden;
        }

        .orders-top-scroll > div {
            height: 1px;
        }

        /* Barres de défilement (haut et bas) plus épaisses : Chrome, Edge, Safari.
           Pas de scrollbar-width/scrollbar-color : ils désactiveraient ces règles. */
        .orders-top-scroll::-webkit-scrollbar,
        .orders-screen-table .table-responsive::-webkit-scrollbar {
            height: 16px;
        }

        .orders-top-scroll::-webkit-scrollbar-track,
        .orders-screen-table .table-responsive::-webkit-scrollbar-track {
            background: #e9ecef;
            border-radius: 8px;
        }

        .orders-top-scroll::-webkit-scrollbar-thumb,
        .orders-screen-table .table-responsive::-webkit-scrollbar-thumb {
            background: #adb5bd;
            border: 3px solid #e9ecef;
            border-radius: 8px;
        }

        .orders-top-scroll::-webkit-scrollbar-thumb:hover,
        .orders-screen-table .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #6c757d;
        }

        /* Quantité totale du produit, tous clients confondus */
        .orders-line-total {
            color: var(--bs-primary, #0d6efd);
            font-weight: 700;
            margin-inline-end: .4rem;
        }

        .orders-total-row td {
            border-top: 2px solid var(--bs-primary, #0d6efd);
            font-weight: 700;
        }

        /* On garde le fond rayé cohérent sur la colonne figée (fond opaque) */
        .orders-screen-table tbody tr:nth-of-type(odd) td:first-child {
            background-color: #f2f2f2;
            background-color: color-mix(in srgb, var(--bs-body-bg, #fff) 95%, #000);
        }

        @media print {
            @page {
                size: A4 landscape;
                margin: 10mm;
            }

            body * {
                visibility: hidden;
            }

            .orders-print-report,
            .orders-print-report * {
                visibility: visible;
            }

            .orders-print-report {
                display: block;
                left: 0;
                position: absolute;
                top: 0;
                width: 100%;
            }

            .orders-print-page {
                break-after: page;
                page-break-after: always;
            }

            .orders-print-page:last-child {
                break-after: auto;
                page-break-after: auto;
            }

            .orders-print-table {
                border-collapse: collapse;
                table-layout: fixed;
                width: 100%;
            }

            .orders-print-table thead {
                display: table-header-group;
            }

            .orders-print-table thead th {
                vertical-align: top;
            }

            .orders-print-table tr {
                break-inside: avoid;
                page-break-inside: avoid;
            }

            .orders-print-table th,
            .orders-print-table td {
                border: 1px solid #000;
                font-size: 10px;
                padding: 4px;
                text-align: center;
            }

            .orders-print-table th:first-child,
            .orders-print-table td:first-child {
                text-align: left;
                width: 22%;
            }
        }
    </style>

    <div class="orders-screen-table pt-5">
        <div class="orders-screen-header d-flex justify-content-between align-items-center mb-4">
            <h1 class="title fw-bold fs-3 m-0">📋 Tableau</h1>

            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-secondary d-none d-md-inline-block" onclick="window.print()">
                    Imprimer / PDF
                </button>

                <ul class="nav nav-pills">
                    {% for dayNum, label in pickupDays %}
                        <li class="nav-item">
                            <a
                                    href="{{ ea_url().set('pickup', dayNum) }}"
                                    class="nav-link {{ selectedPickupDay == dayNum ? 'active' : '' }}"
                            >
                                {{ label }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        {# Barre de défilement du haut, synchronisée avec celle du tableau (script plus bas) #}
        <div class="orders-top-scroll" hidden><div></div></div>

        <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Produit</th>
                    {% for user in users %}
                        <th class="text-center">
                            {{ user.firstName }}<br>{{ user.lastName }}
                            <div class="orders-phone">{{ user.phone }}</div>
                        </th>
                    {% endfor %}
                </tr>
            </thead>

            <tbody>
                {% for line in lines %}
                    <tr>
                        <td>
                            <span class="orders-line-total">{{ line.totalQuantity }}</span>
                            {{ line.productName }}{% if line.variantLabel %} - {{ line.variantLabel }}{% endif %}
                            <small class="text-muted ms-2">({{ line.unit }})</small>
                        </td>
                        {% for user in users %}
                            {% set qty = quantitiesTab[user.id][line.key] ?? '-' %}
                            <td class="text-center">
                                {{ qty }}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>

            {% if users is not empty %}
                <tfoot>
                    <tr class="orders-total-row">
                        <td>Total</td>
                        {% for user in users %}
                            <td class="text-center">{{ (userTotals[user.id] ?? 0)|number_format(2, ',', ' ') }} €</td>
                        {% endfor %}
                    </tr>
                </tfoot>
            {% endif %}
        </table>
        </div>
    </div>

    <script>
        (function () {
            const top    = document.querySelector('.orders-top-scroll');
            const bottom = document.querySelector('.orders-screen-table .table-responsive');
            if (!top || !bottom) {
                return;
            }

            // Same scrollable width as the table; hidden when nothing overflows.
            const resize = () => {
                top.firstElementChild.style.width = bottom.scrollWidth + 'px';
                top.hidden = bottom.scrollWidth <= bottom.clientWidth;
            };

            // Copy only real moves (>= 1px): with display scaling, scrollLeft is
            // fractional and gets rounded, so an exact comparison makes both
            // bars echo each other endlessly (jittery thumb).
            const follow = (from, to) => from.addEventListener('scroll', () => {
                if (Math.abs(to.scrollLeft - from.scrollLeft) >= 1) {
                    to.scrollLeft = from.scrollLeft;
                }
            });
            follow(top, bottom);
            follow(bottom, top);

            resize();
            window.addEventListener('resize', resize);
        })();
    </script>

    <div class="orders-print-report">
        {% for userGroup in users|batch(8) %}
            <section class="orders-print-page">
                <h1>Tableau commandes - {{ pickupDays[selectedPickupDay] }}</h1>
                <p>Imprimé le {{ 'now'|date('d/m/Y à H:i') }}</p>

                <table class="orders-print-table">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            {% for user in userGroup %}
                                <th>{{ user.firstName }}<br>{{ user.lastName }}<br><span class="orders-phone">{{ user.phone }}</span></th>
                            {% endfor %}
                        </tr>
                    </thead>

                    <tbody>
                        {% for line in lines %}
                            <tr>
                                {# Line total covers all customers, not only this page's. #}
                                <td><span class="orders-line-total">{{ line.totalQuantity }}</span> {{ line.productName }}{% if line.variantLabel %} - {{ line.variantLabel }}{% endif %} ({{ line.unit }})</td>
                                {% for user in userGroup %}
                                    <td>{{ quantitiesTab[user.id][line.key] ?? '-' }}</td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>

                    <tfoot>
                        <tr class="orders-total-row">
                            <td>Total</td>
                            {% for user in userGroup %}
                                <td>{{ (userTotals[user.id] ?? 0)|number_format(2, ',', ' ') }} €</td>
                            {% endfor %}
                        </tr>
                    </tfoot>
                </table>
            </section>
        {% else %}
            <section class="orders-print-page">
                <h1>Tableau commandes - {{ pickupDays[selectedPickupDay] }}</h1>
                <p>Imprimé le {{ 'now'|date('d/m/Y à H:i') }}</p>
                <p>Aucune commande à préparer.</p>
            </section>
        {% endfor %}
    </div>
{% endblock %}
